{
	"id":"jdp_phasecloak",
	"type":"PHASE_CLOAK",
	"aiType":"PHASE_CLOAK",
	
	"statsScript":"Jaydee8652.JaydeePiracy.scripts.systems.jdp_PhaseCloakStats",
	"runScriptWhilePaused":true, # only for the player's ship
