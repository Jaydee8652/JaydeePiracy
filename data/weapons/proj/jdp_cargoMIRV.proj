{
	"id":"jdp_cargoMIRV",
	"specClass":"missile",	
	"missileType":"MIRV",
	"sprite":"graphics/proj/jdp_cargoMissile.png",
	"size":[13,44],	
	"center":[6.5,22],
	"collisionRadius":20,
	"collisionClass":"MISSILE_NO_FF",
	"explosionColor":[255,100,100,255],  # purely visual, will get a white additively blended core on top of this color
	"explosionRadius":300, # purely visual
	#"alwaysAccelerate":true,
	"engineSpec":{
				  "turnAcc":20,
				  "turnRate":20,
				  "acc":200,
				  "dec":100},
	"engineSlots":[{"id":"ES1",
					"loc":[-20, 0],
				    #"style":"MISSILE_MIDLINE",
				    "style":"CUSTOM",
					"styleSpec":{
						"mode":"QUAD_STRIP", # PARTICLES or QUAD_STRIP, determines which params are used
						"engineColor":[255,145,75,255],
						"contrailDuration":2,
						"contrailWidthMult":4,
						"contrailWidthAddedFractionAtEnd":2,  # can be negative. makes trail spread out/narrow at the end
						"contrailMinSeg":15, # min segment length, in pixels
						"contrailMaxSpeedMult":.0f,
						"contrailAngularVelocityMult":0.5f,
						"contrailSpawnDistMult":.75, # how far away from engine it starts
						"contrailColor":[100,100,100,150],
						"glowSizeMult":2.5,
						"type":"SMOKE" # GLOW or SMOKE; additive or regular blend mode
					},
				    "width":15.0,
				    "length":39.0,
				    "angle":180.0}],
	"behaviorSpec":{"behavior":"MIRV",
					"splitRange":1400,
					#"minTimeToSplit":1,
					#"splitRangeRange":100,
					"minTimeToSplit":2,
					"canSplitEarly":false,
					"splitSound":"reaper_fire",
					"numShots":1,
					"damage":3000,
					"impact":60,
					"damageType":HIGH_EXPLOSIVE,
					"hitpoints":350,
					#"evenSpread":true,
					"arc":0,
					"spreadInaccuracy":0,
					"spreadSpeed":300, # controls speed of launched projectile
					"spreadSpeedRange":0,
					"projectileSpec":"jdp_cargoRocket",
					"debrisSmall":7,
					"debrisMedium":0,
					"debrisLarge":0,
					"smokeSpec":{"particleSizeMin":5.0,
								 "particleSizeRange":5.0,
